---
import CopyCommand from "../components/CopyCommand.astro";
import Base from "../layouts/Base.astro";

const description =
  "Give coding agents a simple way to share screenshots and artifacts from any machine.";

const features = [
  {
    title: "One-time setup",
    body: "Creates an R2 bucket, scoped credentials, automatic expiry, and the agent skill.",
  },
  {
    title: "Works anywhere",
    body: "Share files from macOS, Windows, Linux, or a headless server with no resident process.",
  },
  {
    title: "Cleans up after itself",
    body: "Artifacts expire after 90 days by default. One command removes the bucket and credentials.",
  },
];
---

<Base title="Pigeon" description={description}>
  <section
    class="mx-auto flex max-w-3xl flex-col items-center px-5 pb-24 pt-36 text-center sm:pt-44"
  >
    <h1 class="max-w-2xl text-4xl font-light leading-[1.1] tracking-tight text-white sm:text-6xl">
      See what your agent <span class="text-sky">sees</span>.
    </h1>
    <p class="mt-6 max-w-md text-sm leading-relaxed text-neutral-500 sm:text-base">
      Give remote coding agents a simple way to share screenshots, reports, and other artifacts with
      you.
    </p>
    <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row">
      <CopyCommand command="p1geon init" />
      <a class="text-sm text-neutral-400 transition-colors hover:text-sky" href="/docs">
        Read the docs
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-28">
    <div
      class="grid gap-px overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.03] sm:grid-cols-3"
    >
      {
        features.map((feature) => (
          <article class="bg-night/40 p-6">
            <h2 class="mb-2 text-sm font-medium text-neutral-200">{feature.title}</h2>
            <p class="text-sm leading-relaxed text-neutral-500">{feature.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</Base>
