---
const { command } = Astro.props;
---

<button
  type="button"
  data-copy={command}
  class="group inline-flex cursor-pointer items-center rounded-full border border-white/10 bg-white/[0.03] font-mono text-sm tracking-tight text-neutral-200 transition-colors hover:border-white/[0.16]"
  aria-label={`Copy ${command}`}
>
  <span class="py-2.5 pl-5 pr-3"><span class="mr-1.5 text-neutral-600">$</span>{command}</span>
  <span class="h-4 w-px bg-white/10"></span>
  <span class="px-3 py-2.5 text-xs text-neutral-500 group-hover:text-sky" data-label>Copy</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      const label = button.querySelector<HTMLElement>("[data-label]");
      if (!label) return;
      label.textContent = "Copied";
      window.setTimeout(() => (label.textContent = "Copy"), 1400);
    });
  });
</script>
